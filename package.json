{
  "name": "medicamento-aberto",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run data:verify && npm run build:ui",
    "build:ui": "tsc -b && vite build",
    "preview": "vite preview",
    "data:fetch": "python scripts/fetch_sources.py --force",
    "data:diagnose": "python scripts/diagnose_data.py",
    "data:build": "python scripts/build_data.py",
    "data:verify": "python scripts/verify_publication.py",
    "data:test": "python scripts/build_data.py --input tests/fixtures --output .tmp/data-test",
    "test:pipeline": "python -m unittest discover -s tests -p \"test_*.py\"",
    "check": "npm run test:pipeline && npm run build:ui",
    "data:changes": "python scripts/check_source_changes.py",
    "data:update": "python scripts/fetch_sources.py --force && python scripts/diagnose_data.py && python scripts/build_data.py && python scripts/verify_publication.py"
  },
  "dependencies": {
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "^5.9.0",
    "vite": "8.2.2"
  }
}
